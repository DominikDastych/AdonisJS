@layouts.app({ title: 'Přehled' })
  @page({
    title: `Vítejte, ${auth.user.fullName ?? auth.user.email}`,
    description: auth.user.isAdmin
      ? 'Jste přihlášen(a) jako administrátor.'
      : 'Jste přihlášen(a) jako běžný uživatel.',
  })
    <div class="empty">
      <div class="empty__mark">
        @svg(auth.user.isAdmin ? 'lucide:shield-check' : 'lucide:user', { width: 22, height: 22 })
      </div>
      @if(auth.user.isAdmin)
        <h1>Správa uživatelů</h1>
        <p>
          V administraci můžete uživatele vyhledávat, vytvářet, upravovat, deaktivovat a mazat.
        </p>
        <p style="margin-top: 12px;">
          @link({ route: 'admin.users.index', class: 'btn btn--primary' })
            @svg('lucide:users', { width: 15, height: 15 })
            Otevřít administraci
          @end
        </p>
      @else
        <h1>Váš účet je aktivní</h1>
        <p>
          Administraci uživatelů mohou používat pouze administrátoři.
        </p>
      @end
    </div>
  @end
@end
