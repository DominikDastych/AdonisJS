<!DOCTYPE html>
<html
  lang="cs"
  data-theme="{{
    request.plainCookie('app_theme', {
      defaultValue: 'light',
      encoded: false,
    })
  }}"
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AdonisJS — Starter Kit</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body>
    <div class="auth">
      <div class="auth__form-col">
        @!logo({ size: 28 })
        <div class="auth__form-wrap">{{{ await $slots.main() }}}</div>
        <div style="height: 20px;"></div>
      </div>

      <aside class="auth__aside">
        <div class="auth__aside-top">
          @!themeToggle()
        </div>

        <p class="auth__quote">Správa uživatelů postavená na AdonisJS a SQLite.</p>

        <div>
          <div class="pitch__t">Demo účty</div>
          <p class="pitch__p">
            Administrátor: admin@example.com / admin1234<br />
            Uživatel: petra.svobodova@example.com / password123
          </p>
        </div>
      </aside>
    </div>
    @include('partials/flash_alerts')
  </body>
</html>
